# URL del proyecto. Supabase → Project Settings → Data API
SUPABASE_URL=

# Llave secreta (equivale a service_role). Solo servidor, nunca en el navegador.
# Supabase → Project Settings → API Keys
SUPABASE_SECRET_KEY=

# Llave de Groq para generar los borradores. Solo servidor.
# Si falta, la app funciona igual y el botón de borrador avisa que no está configurado.
# console.groq.com → API Keys
GROQ_API_KEY=